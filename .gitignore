/dist/
# `go build ./cmd/agent` from the repo root drops the binary here; one got
# committed by accident once (#96). Release binaries go to GitHub Releases.
/agent
/agent.exe
*.out
.DS_Store

# .agent/ is the agent's per-workspace runtime state (goal/history/sessions/
# facts/traces/seeded skills) — dogfooding the binary from this repo's own
# checkout writes it right here. None of it is source; ignore all of it except
# the checked-in example config.
.agent/*
!.agent/config.example.json

# Python bytecode from running scripts/
__pycache__/
